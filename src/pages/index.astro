---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ChatWindow from '../components/ChatWindow.astro';
import brakeDisc from '../assets/parts/brake-disc.webp';
import shock from '../assets/parts/shock.webp';
import automotiveParts from '../../assets/categorias/repuestos-autmotrices.png';
import heavyMachinery from '../../assets/categorias/maquinaria-pesada.png';
import electricalComponents from '../../assets/categorias/conponentes-electricos.png';
import hydraulicParts from '../../assets/categorias/hidraulica.png';
import transmissionParts from '../../assets/categorias/transmision.png';
import tools from '../../assets/categorias/herramientas.png';

const steps = [
  ['Contanos qué buscás', 'Indicá el repuesto, la marca, modelo y año de tu vehículo. Si tenés una foto, también podés adjuntarla.'],
  ['Confirmá tu solicitud', 'Lyra resume los datos, confirma tu nombre y genera un código único para tu consulta.'],
  ['Seguimiento por WhatsApp', 'Enviás la orden sin repetir información. El equipo revisa tu solicitud y te acompaña para coordinar con el proveedor o la entrega.'],
];

const faqs = [
  ['¿Necesito conocer el nombre exacto del repuesto?', 'No. Contanos qué necesitás y, si podés, indicá la marca, modelo y año del vehículo. Lyra te guiará para completar los datos.'],
  ['¿Publicar una solicitud tiene costo?', 'No. Publicar tu solicitud es gratis y rápido.'],
  ['¿Qué sucede después de confirmar mi solicitud?', 'Lyra genera un código único para tu consulta. Con el botón Enviar orden continuás por WhatsApp sin tener que repetir los datos.'],
  ['¿Qué pasa después de enviar la orden por WhatsApp?', 'Nuestro equipo revisa tu solicitud y te acompaña para coordinar directamente con el proveedor o gestionar la compra y entrega.'],
];

const categories = [
  { label: 'Repuestos automotrices', key: 'automotive', image: automotiveParts, description: 'Motores, frenos, suspensiones y componentes críticos para flotas ligeras y pesadas.' },
  { label: 'Maquinaria pesada', key: 'heavy', image: heavyMachinery, description: 'Equipamiento especializado para sectores de minería, construcción y agroindustria.' },
  { label: 'Componentes eléctricos', key: 'electrical', image: electricalComponents, description: 'Alternadores, sistemas de control, cableado industrial y sensores de alta precisión.' },
  { label: 'Hidráulica', key: 'hydraulic', image: hydraulicParts, description: 'Bombas hidráulicas, mangueras de alta presión, válvulas y actuadores industriales.' },
  { label: 'Transmisión', key: 'transmission', image: transmissionParts, description: 'Cajas de cambio, ejes diferenciales, embragues y sistemas de tracción.' },
  { label: 'Herramientas', key: 'tools', image: tools, description: 'Equipos de taller, herramientas de medición y consumibles industriales de calidad.' },
];
---

<BaseLayout title="Te lo busco Ya | Cotizá repuestos sin vueltas" description="Pedí cotizaciones de repuestos y accesorios con distribuidores auditados en Bolivia.">
  <a class="skip-link" href="#cotizar">Ir al asistente de cotización</a>
  <Header />

  <main id="inicio">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="hero-location">Bolivia · Santa Cruz y cobertura nacional</p>
        <h1 id="hero-title">¿No encuentras lo que buscas?</h1>
        <p class="hero-summary">Contá qué necesitás y convertimos tu búsqueda en una solicitud clara para una red de distribuidores auditados.</p>
        <div class="hero-actions">
          <a class="button-primary" href="#cotizar">Iniciar una cotización</a>
          <a class="text-link" href="#ruta">Ver cómo funciona <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 12h13M13 6l6 6-6 6" /></svg></a>
        </div>
        <ul class="hero-assurance" aria-label="Respaldo de la red">
          <li><svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="m5 12 4 4L19 6" /></svg>Proveedores auditados</li>
          <li><svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="m5 12 4 4L19 6" /></svg>Facturación y devolución</li>
        </ul>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="hero-art-depth">
          <span class="hero-orbit hero-orbit--one"></span>
          <span class="hero-orbit hero-orbit--two"></span>
          <Image class="hero-part hero-part--disc" src={brakeDisc} alt="" loading="eager" decoding="async" />
          <Image class="hero-part hero-part--shock" src={shock} alt="" loading="eager" decoding="async" />
        </div>
      </div>

      <ChatWindow />
    </section>

    <section id="ruta" class="route" aria-labelledby="route-title">
      <div class="route-intro">
        <h2 id="route-title">¿Cómo funciona?</h2>
        <p>La conversación empieza en la web y continúa por WhatsApp cuando tu solicitud está confirmada.</p>
      </div>
      <ol class="route-steps" data-route-steps>
        {steps.map(([title, description], index) => (
          <li class="route-step">
            <span class="step-count">{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="categorias" class="parts-index" aria-labelledby="parts-title">
      <div class="parts-art" data-parts-art data-active="automotive" aria-hidden="true">
        {categories.map(({ image, label, key }, index) => (
          <Image class={`category-art${index === 0 ? ' is-active' : ''}`} data-category-image={key} src={image} alt="" loading="lazy" decoding="async" />
        ))}
      </div>
      <div class="parts-content">
        <h2 id="parts-title">Categorías principales</h2>
        <p class="parts-intro">Puedes consultar estas categorías y mucho más.</p>
        <ul class="category-list">
          {categories.map(({ label, key }, index) => (
            <li>
              <button class="category-trigger" type="button" data-category={key} aria-controls={`category-detail-${key}`} aria-pressed={index === 0 ? 'true' : 'false'}>
                <span>{label}</span>
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
              </button>
            </li>
          ))}
        </ul>
        <div class="category-detail" aria-live="polite">
          {categories.map(({ description, key }, index) => (
            <p id={`category-detail-${key}`} data-category-description={key} hidden={index !== 0}>{description}</p>
          ))}
        </div>
      </div>
    </section>

    <section id="nosotros" class="company" aria-labelledby="company-title">
      <div class="company-intro">
        <h2 id="company-title">Conectamos la urgencia con la disponibilidad.</h2>
        <p>Somos la plataforma líder en Bolivia para la gestión de repuestos. Conectamos la urgencia con la disponibilidad, impulsando la eficiencia en cada rincón del país.</p>
      </div>
      <div class="company-principles">
        <article class="company-principle">
          <h3>Nuestra Misión</h3>
          <p>Nuestra misión es conectar de manera inmediata a los dueños de vehículos en Santa Cruz con el repuesto exacto que necesitan, eliminando las barreras de tiempo, tráfico y distancia a través de soluciones tecnológicas y una logística eficiente que garantice tranquilidad al conductor.</p>
        </article>
        <article class="company-principle">
          <h3>Nuestra Visión</h3>
          <p>Para el 2030, ser la plataforma líder y más confiable de búsqueda y suministro de repuestos automotrices en Bolivia, reconocida por digitalizar el mercado tradicional y transformar la experiencia de mantenimiento vehicular en una gestión rápida, transparente y al alcance de un clic.</p>
        </article>
      </div>
    </section>

    <section id="respaldo" class="trust" data-trust aria-labelledby="trust-title">
      <div>
        <p class="trust-number" data-count="500" aria-label="Más de 500 distribuidores auditados">+500</p>
        <p class="trust-label">distribuidores auditados</p>
      </div>
      <div class="trust-copy">
        <h2 id="trust-title">Encontrar rápido también puede tener respaldo.</h2>
        <p>Trabajamos con una red de distribuidores que ofrece facturación y políticas de devolución.</p>
        <a class="button-light" href="#cotizar">Hablar con Lyra</a>
      </div>
    </section>

    <section id="preguntas" class="faq" aria-labelledby="faq-title">
      <div class="faq-intro">
        <p class="section-kicker">Resolvemos tus dudas</p>
        <h2 id="faq-title">Preguntas frecuentes</h2>
        <p>Todo lo necesario para publicar una solicitud y elegir con confianza.</p>
      </div>
      <div class="faq-list">
        {faqs.map(([question, answer], index) => (
          <details class="faq-item" open={index === 0}>
            <summary>
              <span>{question}</span>
              <svg class="faq-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" /></svg>
            </summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <footer>
    <a class="brand" href="#inicio" aria-label="Volver al inicio de Te lo busco Ya">
      <img src="/brand/logo.webp" width="40" height="40" alt="" />
      <span>Te lo busco <strong>Ya</strong></span>
    </a>
    <div class="footer-contact">
      <p>Santa Cruz · Cobertura nacional</p>
      <a href="mailto:telobuscoya@gmail.com">telobuscoya@gmail.com</a>
    </div>
    <div class="footer-social">
      <p>Seguinos</p>
      <div class="social-links">
        <a href="https://www.instagram.com/" target="_blank" rel="noreferrer" aria-label="Instagram de Te lo busco Ya">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none" /></svg>
        </a>
        <a href="https://www.facebook.com/" target="_blank" rel="noreferrer" aria-label="Facebook de Te lo busco Ya">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M14.5 21v-7h2.5l.5-3h-3v-1.7c0-1 .3-1.7 1.8-1.7H18V4.9c-.4-.1-1.2-.2-2.2-.2-2.2 0-3.8 1.3-3.8 3.8V11H9.5v3H12v7" /></svg>
        </a>
        <a href="https://www.linkedin.com/" target="_blank" rel="noreferrer" aria-label="LinkedIn de Te lo busco Ya">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M7 9v8M7 6.5v.1M11 17v-4.4c0-2.3 1.4-3.6 3.2-3.6 1.9 0 2.8 1.2 2.8 3.6V17M11 12.4V9" /></svg>
        </a>
      </div>
    </div>
  </footer>
  <a class="whatsapp-float" href="https://wa.me/59175968723?text=Hola%2C%20necesito%20ayuda%20para%20encontrar%20un%20repuesto." target="_blank" rel="noreferrer" aria-label="Escribir a Te lo busco Ya por WhatsApp">
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M20.4 11.5a8.2 8.2 0 0 1-11.8 7.3L4 20l1.2-4.2a8.2 8.2 0 1 1 15.2-4.3Z" /><path d="M9 8.4c.2-.5.4-.5.7-.5h.4c.2 0 .4.1.5.4l.7 1.6c.1.2.1.4 0 .6l-.5.7c.5 1 1.3 1.8 2.3 2.3l.7-.5c.2-.1.4-.1.6 0l1.6.7c.3.1.4.3.4.5v.4c0 .3 0 .5-.5.7-.4.2-1 .4-1.8.2-1.2-.3-2.8-1.4-4-2.6-1.2-1.2-2.3-2.8-2.6-4-.2-.8 0-1.4.2-1.8Z" /></svg>
    <span>WhatsApp</span>
  </a>
  <script>
    const hero = document.querySelector('.hero');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const canAnimate = !reducedMotion.matches;

    if (hero && canAnimate) {
      let isVisible = false;
      const updateArtMotion = () => hero.toggleAttribute('data-art-active', isVisible && !document.hidden);
      const observer = new IntersectionObserver(([entry]) => {
        isVisible = entry.isIntersecting;
        updateArtMotion();
      }, { threshold: 0.08 });

      observer.observe(hero);
      document.addEventListener('visibilitychange', updateArtMotion);

      const artDepth = hero.querySelector('.hero-art-depth');
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

      if (artDepth && finePointer.matches) {
        let depthFrame;
        let depth = { x: 0, y: 0 };
        const updateDepth = () => {
          artDepth.style.setProperty('--art-pointer-x', `${depth.x * 22}px`);
          artDepth.style.setProperty('--art-pointer-y', `${depth.y * 16}px`);
          artDepth.style.setProperty('--art-pointer-rotate', `${depth.x * .7}deg`);
          depthFrame = undefined;
        };

        hero.addEventListener('pointermove', (event) => {
          const bounds = hero.getBoundingClientRect();
          depth = {
            x: ((event.clientX - bounds.left) / bounds.width) - .5,
            y: ((event.clientY - bounds.top) / bounds.height) - .5,
          };
          if (!depthFrame) depthFrame = window.requestAnimationFrame(updateDepth);
        });
        hero.addEventListener('pointerleave', () => {
          depth = { x: 0, y: 0 };
          if (!depthFrame) depthFrame = window.requestAnimationFrame(updateDepth);
        });
      }

    }

    const routeSteps = document.querySelector('[data-route-steps]');
    if (routeSteps && canAnimate) {
      const steps = [...routeSteps.querySelectorAll('.route-step')];
      let routeVisible = false;
      let routeFrame;
      const updateRoute = () => {
        if (!routeVisible) {
          routeFrame = undefined;
          return;
        }
        const bounds = routeSteps.getBoundingClientRect();
        const startLine = window.innerHeight * .72;
        const finishLine = window.innerHeight * .38;
        const travel = Math.max(bounds.height + startLine - finishLine, 1);
        const progress = Math.min(1, Math.max(0, (startLine - bounds.top) / travel));
        routeSteps.style.setProperty('--route-progress', progress.toFixed(3));
        steps.forEach((step, index) => step.classList.toggle('is-active', progress >= index / steps.length));
        routeFrame = undefined;
      };
      const requestRouteUpdate = () => {
        if (!routeFrame) routeFrame = window.requestAnimationFrame(updateRoute);
      };
      const routeObserver = new IntersectionObserver(([entry]) => {
        routeVisible = entry.isIntersecting;
        if (routeVisible) requestRouteUpdate();
      }, { threshold: .08 });

      routeObserver.observe(routeSteps);
      window.addEventListener('scroll', requestRouteUpdate, { passive: true });
      window.addEventListener('resize', requestRouteUpdate);
    }

    const partsArt = document.querySelector('[data-parts-art]');
    const categoryTriggers = [...document.querySelectorAll('[data-category]')];
    if (partsArt && categoryTriggers.length) {
      const categoryImages = [...partsArt.querySelectorAll('[data-category-image]')];
      const categoryDescriptions = [...document.querySelectorAll('[data-category-description]')];
      const setCategory = (trigger) => {
        const category = trigger.dataset.category;
        partsArt.dataset.active = category;
        categoryTriggers.forEach((item) => item.setAttribute('aria-pressed', String(item === trigger)));
        categoryImages.forEach((image) => image.classList.toggle('is-active', image.dataset.categoryImage === category));
        categoryDescriptions.forEach((description) => {
          description.hidden = description.dataset.categoryDescription !== category;
        });
      };
      categoryTriggers.forEach((trigger) => {
        trigger.addEventListener('pointerenter', () => setCategory(trigger));
        trigger.addEventListener('focus', () => setCategory(trigger));
        trigger.addEventListener('click', () => setCategory(trigger));
      });
    }

    const trust = document.querySelector('[data-trust]');
    const trustNumber = trust?.querySelector('[data-count]');
    if (trust && trustNumber && canAnimate) {
      const target = Number(trustNumber.dataset.count);
      const startCounter = () => {
        const duration = 1200;
        const startedAt = performance.now();
        trustNumber.animate?.([
          { opacity: .45, transform: 'translate3d(0, 24px, 0) scale(.92)' },
          { opacity: 1, transform: 'translate3d(0, 0, 0) scale(1)' },
        ], { duration: 720, easing: 'cubic-bezier(.16, 1, .3, 1)', fill: 'both' });
        const updateCounter = (now) => {
          const progress = Math.min(1, (now - startedAt) / duration);
          const value = Math.round(target * (1 - Math.pow(1 - progress, 4)));
          trustNumber.textContent = `+${value}`;
          if (progress < 1) window.requestAnimationFrame(updateCounter);
          else trustNumber.textContent = `+${target}`;
        };
        window.requestAnimationFrame(updateCounter);
      };
      const trustObserver = new IntersectionObserver(([entry], observer) => {
        if (!entry.isIntersecting) return;
        observer.unobserve(trust);
        startCounter();
      }, { threshold: .35 });

      trustObserver.observe(trust);
    }

    const footer = document.querySelector('footer');
    const whatsappFloat = document.querySelector<HTMLElement>('.whatsapp-float');
    if (footer && whatsappFloat) {
      let footerFrame: number | undefined;
      const updateWhatsappOffset = () => {
        const footerTop = footer.getBoundingClientRect().top;
        const footerOverlap = Math.max(0, window.innerHeight - footerTop);
        const offset = Math.min(footer.offsetHeight + 16, footerOverlap);
        whatsappFloat.style.setProperty('--whatsapp-footer-offset', `${offset}px`);
        footerFrame = undefined;
      };
      const requestWhatsappOffset = () => {
        if (!footerFrame) footerFrame = window.requestAnimationFrame(updateWhatsappOffset);
      };

      requestWhatsappOffset();
      window.addEventListener('scroll', requestWhatsappOffset, { passive: true });
      window.addEventListener('resize', requestWhatsappOffset);
    }
  </script>
</BaseLayout>
